# AnswerGuard Environment Variables

# Database connection string
# SQLite (local dev):   sqlite:///./answerguard.db
# PostgreSQL (prod):    postgresql://user:password@host:5432/answerguard
DATABASE_URL=sqlite:///./answerguard.db

# BigQuery source connector
GCP_PROJECT_ID=your-gcp-project-id

# Path to GCP service account JSON key file
# Leave empty to use Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery page size for bulk import (default: 5000)
BIGQUERY_PAGE_SIZE=5000
